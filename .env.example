# ===================== 服务端口 =====================
# 后端应用监听端口（容器内部端口）
PROXY_PORT=8080

# Docker Compose 专用：Nginx 对外暴露端口
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# ===================== 运行模式 =====================
# Docker Compose 专用：gin 运行模式（release / debug）
GIN_MODE=release

# 网关实例标识（写入 request_logs.gateway_node）
# 留空则自动使用容器/主机 hostname，多副本部署时无需手工指定
# GATEWAY_NODE=xin-api-node-1

# ===================== PostgreSQL（管理元数据） =====================
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=root
POSTGRES_PASSWORD=123456
POSTGRES_DB=gateway

# ===================== Redis 配置 =====================
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=123456
REDIS_DB=0
REDIS_POOL_SIZE=20

# ===================== 安全与鉴权 =====================
# Admin API JWT 签名密钥（必填），生产环境务必使用 ≥32 位随机字符串
# 生成示例：openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRE=24h

# 首次初始化 admin 账号时的口令；留空则服务启动时随机生成并打印到日志（仅显示一次）
# ADMIN_INIT_PASSWORD=

# ===================== 熔断器 =====================
CB_FAILURE_THRESHOLD=5
CB_RECOVERY_INTERVAL=60s

# ===================== 缓存配置 =====================
# 渠道缓存池过期时间
CACHE_CHANNEL_EXPIRE=300s

# ===================== 请求/响应原文落库 =====================
# 默认关闭；开启后写入 request_payloads（流式响应最多保留 1 MiB）
LOG_REQUEST_BODY=false
LOG_RESPONSE_BODY=false

# ===================== 上游代理 =====================
PROXY_REQUEST_TIMEOUT=120s
PROXY_MAX_BODY_MB=10

# ===================== 计费 =====================
# USD → CNY 结算汇率
USD_CNY_RATE=7.2
