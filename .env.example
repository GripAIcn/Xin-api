# ===================== 服务端口 =====================
# 数据面 API 端口
PROXY_PORT=8080
# Docker Compose: Nginx 反向代理端口（仅 compose 部署使用）
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# ===================== 运行模式 =====================
# Docker Compose: 传递给容器的运行模式（仅 compose 部署使用）
GIN_MODE=release
LOG_LEVEL=info

# ===================== PostgreSQL (管理元数据) =====================
POSTGRES_HOST=127.0.0.1
POSTGRES_USER=root
POSTGRES_PASSWORD=123456
POSTGRES_DB=gateway
POSTGRES_PORT=5432

# ===================== Redis 配置 =====================
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=123456
REDIS_DB=0
REDIS_POOL_SIZE=20

# ===================== 安全与鉴权 =====================
# Admin API JWT 签名密钥（生产务必更换为强随机字符串）
JWT_SECRET=123456zbcd+-
JWT_EXPIRE=24h

# ===================== 熔断器 =====================
CB_FAILURE_THRESHOLD=5
CB_RECOVERY_INTERVAL=60s

# ===================== 上游代理 =====================
PROXY_REQUEST_TIMEOUT=180s
PROXY_MAX_BODY_MB=10

# ===================== 限流默认值 =====================
# Docker Compose: 传递给容器的限流配置（仅 compose 部署使用）
DEFAULT_RPM=60
DEFAULT_TPM=100000
