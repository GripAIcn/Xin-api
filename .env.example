# ===================== 服务端口 =====================
# 数据面 API 端口
PROXY_PORT=8080
# 管理面端口（内嵌 WebUI）
ADMIN_PORT=9090

# ===================== Nginx 端口 =====================
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# ===================== PostgreSQL配置(管理元数据)  =====================
POSTGRES_USER=root
POSTGRES_PASSWORD=123456
POSTGRES_DB=gateway
POSTGRES_PORT=5432
POSTGRESQL_DSN=host=127.0.0.1 user=root password=123456 dbname=gateway port=5432 sslmode=disable TimeZone=Asia/Shanghai

# ===================== Redis 配置 =====================
REDIS_PORT=6379

# ===================== 运行模式 =====================
# debug / release
GIN_MODE=debug
LOG_LEVEL=debug

# ===================== Redis =====================
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=123456
REDIS_DB=1
REDIS_POOL_SIZE=20

# ===================== ClickHouse =====================
CLICKHOUSE_DSN=tcp://127.0.0.1:9000?database=ai_gateway&username=default&password=&compress=true
CLICKHOUSE_TRACE_TABLE=gateway_trace
CLICKHOUSE_BATCH_SIZE=1000
CLICKHOUSE_FLUSH_INTERVAL=1s

# ===================== 安全与鉴权 =====================
# Admin API JWT 签名密钥（生产务必更换为强随机字符串）
JWT_SECRET=123456zbcd+-
JWT_EXPIRE=24h
# 请求体最大大小（MB）
MAX_REQUEST_BODY_MB=10
# 响应体最大大小（MB）
MAX_RESPONSE_BODY_MB=50

# ===================== 流式超时 =====================
SSE_IDLE_TIMEOUT=300s
SSE_TOTAL_TIMEOUT=600s

# ===================== 熔断器 =====================
CB_FAILURE_THRESHOLD=5
CB_RECOVERY_INTERVAL=60s

# ===================== 上游代理 =====================
PROXY_REQUEST_TIMEOUT=180s
PROXY_MAX_BODY_MB=10

# ===================== 限流默认值 =====================
DEFAULT_RPM=60
DEFAULT_TPM=100000

# ===================== 链路追踪 =====================
# 是否存储原始 Prompt/Completion 哈希（生产建议 false）
TRACE_STORE_HASH=true
# 是否记录原文（强烈建议生产关闭）
TRACE_STORE_BODY=false